# VaultExpiry environment variables.
# Copy to .env for local development. On Railway, set these under the service's Variables tab.
# See README.md → "Railway variables" for the full reference.

# --- Required ---------------------------------------------------------------
# PostgreSQL connection string. On Railway use the reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://vault:vault@localhost:5432/vaultexpiry
# Signs session cookies. At least 32 random characters. Changing it signs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Required in production -------------------------------------------------
# Public URL, no trailing slash. Used in emails, calendar links and the CSRF origin check.
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Server -----------------------------------------------------------------
# Railway injects PORT automatically; don't set it there.
PORT=3000
# Proxy hops in front of the app (Railway: 1). Used for client IPs in rate limits and audit logs.
TRUST_PROXY=1

# --- Database ---------------------------------------------------------------
# "true" only when connecting over a TLS-required public URL. Not needed with Railway private networking.
DATABASE_SSL=false
# Connections per app instance. Keep replicas × this below your Postgres max_connections.
DATABASE_POOL_MAX=10

# --- Email (optional; enables password-reset and reminder emails) -------------
# With no SMTP_HOST, nothing is sent (development logs the email instead).
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually port 465); "false" for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VaultExpiry <no-reply@example.com>"

# --- Features ---------------------------------------------------------------
REMINDERS_ENABLED=true
SIGNUP_ENABLED=true

# --- Platform admin bootstrap (optional) ------------------------------------
# On boot, creates this admin account if it doesn't exist yet. It never promotes an
# existing account and never changes a password. Remove ADMIN_PASSWORD after the first deploy.
# Alternative: npm run admin:seed -- --email you@example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin

# --- Document photos (optional) ----------------------------------------------
# Encrypts document photos at rest (AES-256-GCM). Leave empty to disable photo storage.
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: if you lose or change this key, every stored photo becomes unreadable. Back it up.
FILE_ENCRYPTION_KEY=

# --- AI photo scanning via Groq (optional) ------------------------------------
# Leave empty to disable "Scan a photo". Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Vision model ID (check https://console.groq.com/docs/vision; preview models can be retired at short notice)
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=30000
