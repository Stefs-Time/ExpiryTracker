# --- Required ---
# PostgreSQL connection string. Railway injects this when you reference the Postgres service.
DATABASE_URL=postgres://vault:vault@localhost:5432/vaultexpiry
# Long random string used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Recommended ---
NODE_ENV=development
# Railway sets PORT automatically. Locally defaults to 3000.
PORT=3000
# Public URL of the app (used in emails and calendar feed links). No trailing slash.
APP_URL=http://localhost:3000
# Set to "true" when DATABASE_URL requires TLS (e.g. Railway public proxy URL). Railway private networking does not.
DATABASE_SSL=false

# --- Optional: outgoing email (password reset + expiry reminders) ---
# If SMTP_HOST is empty, emails are not sent; in development the content is logged to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VaultExpiry <no-reply@example.com>"

# Set to "false" to disable the hourly reminder job in this instance.
REMINDERS_ENABLED=true
# Set to "false" to disable public sign-up (existing users can still log in).
SIGNUP_ENABLED=true
